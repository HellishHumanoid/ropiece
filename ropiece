-- Toggle button factory
local function makeToggle(parent, yPos, labelText, onColor)
    local row = Instance.new("Frame", parent)
    row.Size             = UDim2.new(1, -16, 0, 28)
    row.Position         = UDim2.new(0, 8, 0, yPos)
    row.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    row.BorderSizePixel  = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size               = UDim2.new(1, -52, 1, 0)
    lbl.Position           = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text               = labelText
    lbl.TextColor3         = Color3.fromRGB(200, 200, 215)
    lbl.TextSize           = 12
    lbl.Font               = Enum.Font.Gotham
    lbl.TextXAlignment     = Enum.TextXAlignment.Left

    -- Toggle pill
    local pill = Instance.new("Frame", row)
    pill.Size             = UDim2.new(0, 38, 0, 20)
    pill.Position         = UDim2.new(1, -46, 0.5, -10)
    pill.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
    pill.BorderSizePixel  = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", pill)
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(160, 160, 180)
    knob.BorderSizePixel  = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = false
    local TweenService = game:GetService("TweenService")
    local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad)

    local function setState(v, callback)
        state = v
        TweenService:Create(pill,  info, { BackgroundColor3 = v and onColor or Color3.fromRGB(55, 55, 68) }):Play()
        TweenService:Create(knob,  info, { Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }):Play()
        TweenService:Create(knob,  info, { BackgroundColor3 = v and Color3.fromRGB(255,255,255) or Color3.fromRGB(160,160,180) }):Play()
        if callback then callback(v) end
    end

    row.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            setState(not state, row:GetAttribute("_callback"))
        end
    end)

    return {
        setState = setState,
        getState = function() return state end,
        row      = row,
    }
end

--==========================================================
-- Toggles
--==========================================================
local autoChestRunning  = false
local autoRejoinRunning = false

local toggleChest  = makeToggle(frame, 58, "Auto-Chest",          Color3.fromRGB(80, 180, 120))
local toggleRejoin = makeToggle(frame, 90, "Auto-Chest + Rejoin", Color3.fromRGB(90, 140, 220))

-- Auto-Chest callback
toggleChest.setState(false, function(on)
    autoChestRunning = on
    if on then
        setStatus("Collecting chests...", Color3.fromRGB(80, 200, 120))
        task.spawn(function()
            while autoChestRunning do
                local n = fireAllChests()
                setStatus("Opened " .. n .. " chests.", Color3.fromRGB(80, 200, 120))
                task.wait(0.5)
            end
            setStatus("Idle", Color3.fromRGB(100, 100, 120))
        end)
    else
        setStatus("Idle", Color3.fromRGB(100, 100, 120))
    end
end)

-- Route the toggle through a public setter
local function setChest(on)
    toggleChest.setState(on, function(v)
        autoChestRunning = v
        if v then
            setStatus("Collecting chests...", Color3.fromRGB(80, 200, 120))
            task.spawn(function()
                while autoChestRunning do
                    local n = fireAllChests()
                    setStatus("Opened " .. n .. " chests.", Color3.fromRGB(80, 200, 120))
                    task.wait(0.5)
                end
                setStatus("Idle", Color3.fromRGB(100, 100, 120))
            end)
        else
            setStatus("Idle", Color3.fromRGB(100, 100, 120))
        end
    end)
end

local function setRejoin(on)
    toggleRejoin.setState(on, function(v)
        autoRejoinRunning = v
        if v then
            task.spawn(function()
                while autoRejoinRunning do
                    local n = fireAllChests()
                    setStatus("Opened " .. n .. " — rejoining in 6s...", Color3.fromRGB(90, 160, 240))
                    task.wait(6)
                    doRejoin()
                    local waited = 0
                    while autoRejoinRunning and waited < 20 do
                        task.wait(1); waited += 1
                    end
                    if autoRejoinRunning then
                        setStatus("Rejoin failed, retrying...", Color3.fromRGB(220, 100, 80))
                    end
                end
            end)
        else
            clearConfig()
            setStatus("Idle", Color3.fromRGB(100, 100, 120))
        end
    end)
end

-- Wire up clicks
toggleChest.row.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1
    or inp.UserInputType == Enum.UserInputType.Touch then
        setChest(not toggleChest.getState())
    end
end)

toggleRejoin.row.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1
    or inp.UserInputType == Enum.UserInputType.Touch then
        setRejoin(not toggleRejoin.getState())
    end
end)

--==========================================================
-- Drag
--==========================================================
do
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = inp.Position; startPos = frame.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                       startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

