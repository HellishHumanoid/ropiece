local _MARKER         = "AutoChest_v1"

-- ⚠ Set this to your raw GitHub URL
-- Example: https://raw.githubusercontent.com/YourName/YourRepo/main/AutoChest.lua
local SCRIPT_URL = "https://raw.githubusercontent.com/HellishHumanoid/ropiece/refs/heads/main/ropiece"

-- Loader: downloads and runs the script fresh on every rejoin
local LOADER = 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '", true))()'

-- If a GUI already exists from a double-execution, remove it and continue
local existingGui = player:WaitForChild("PlayerGui"):FindFirstChild("AutoChestGui")
if existingGui then existingGui:Destroy() end

local CONFIG_FILE   = "autochest_config.json"
local AUTOEXEC_FILE = "autoexec/AutoChest.lua"

local function setupRejoin()
    -- Write the one-liner to autoexec
    pcall(function() writefile(AUTOEXEC_FILE, LOADER) end)
    -- Queue it for the next session
    local queued = false
    if not queued then pcall(function() queueteleport(LOADER);    queued = true end) end
    if not queued then pcall(function() queue_on_teleport(LOADER); queued = true end) end
end

--==========================================================
-- Config
--==========================================================
local savedConfig = {}
pcall(function()
    local raw = readfile(CONFIG_FILE)
    if raw and raw ~= "" then savedConfig = HttpService:JSONDecode(raw) or {} end
end)

local function saveConfig(t)
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(t)) end)
end

local function clearConfig()
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode({})) end)
end

--==========================================================
-- Chest / Rejoin logic
--==========================================================
local function getAllClickDetectors()
    local list = {}
    local treasure = workspace:FindFirstChild("treasure")
    if not treasure then return list end
    for _, coin in ipairs(treasure:GetChildren()) do
        if coin.Name == "coin" then
            for _, obj in ipairs(coin:GetDescendants()) do
                if obj:IsA("ClickDetector") then table.insert(list, obj) end
            end
        end
    end
    return list
end

local function fireAllChests()
    local detectors = getAllClickDetectors()
    for _, cd in ipairs(detectors) do
        task.spawn(function() pcall(fireclickdetector, cd) end)
    end
    return #detectors
end

local function setupRejoin()
    -- Queue and write the GitHub loadstring — downloads fresh script every rejoin
    pcall(function() writefile(AUTOEXEC_FILE, LOADER) end)
    local queued = false
    if not queued then pcall(function() queueteleport(LOADER);    queued = true end) end
    if not queued then pcall(function() queue_on_teleport(LOADER); queued = true end) end
end

local function doRejoin()
    saveConfig({ autoRejoin = true })
    task.wait(0.1)
    setupRejoin()
    task.wait(0.2)

    -- Keep spamming until the session ends
    while true do
        pcall(function()
            if #Players:GetPlayers() <= 1 then
                player:Kick("\nRejoining...")
                task.wait(0.5)
                TeleportService:Teleport(game.PlaceId, player)
            else
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
            end
        end)
        task.wait(1)
    end
end

